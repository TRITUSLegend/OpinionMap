# ============================================================
# OpinionMap — Environment Configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to git — it is gitignored.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=OpinionMap
# Set DEBUG=false in production and on Render.
# DEBUG=true activates synthetic data fallback for all scrapers.
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL via Docker Compose) ─────────────────
# These must match the postgres service in docker-compose.yml.
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentflow
# Full async URL — constructed from the three vars above.
DATABASE_URL=postgresql+asyncpg://agentflow:changeme@postgres:5432/agentflow

# ── Authentication ───────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
# Set to 480 (8 hours) for comfortable demo sessions.
# The default of 30 minutes causes mid-demo logouts.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt cost for password hashes: 10-15, default 12. Each +1 doubles the CPU
# time of every login and signup. Existing hashes move to the new cost on the
# user's next successful login, so changing it never locks anyone out.
BCRYPT_ROUNDS=12

# ── Google Gemini AI ─────────────────────────────────────────
# Required for all AI analysis. Get your key at: aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# ── YouTube Data API v3 ──────────────────────────────────────
# Free: 10,000 units/day. Enable at: console.cloud.google.com
# Leave blank to use synthetic demo data.
YOUTUBE_API_KEY=your-youtube-api-key

# ── Reddit API ───────────────────────────────────────────────
# Free (approval required): reddit.com/prefs/apps
# Leave blank to use synthetic demo data.
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=OpinionMap/1.0 (by /u/your-reddit-username)

# ── NewsData.io ──────────────────────────────────────────────
# Free: 200 req/day. Sign up at: newsdata.io
# Leave blank to use synthetic demo data.
NEWSDATA_API_KEY=your-newsdata-api-key

# ── The Guardian API ─────────────────────────────────────────
# Free: 5,000 req/day. Register at: open-platform.theguardian.com
# Leave blank to use synthetic demo data.
GUARDIAN_API_KEY=your-guardian-api-key

# ── Bluesky (AT Protocol) ────────────────────────────────────
# Required for live Bluesky search (public endpoint now requires auth).
# Use an app password, not your main Bluesky password.
# Settings → Privacy and Security → App Passwords → Add App Password
# Leave blank to use synthetic demo data.
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password

# ── ChromaDB (Ask AI vectors) ────────────────────────────────
# Vectors are a rebuildable cache; Postgres stays the source of truth.
# CHROMA_HOST empty = local on-disk store in CHROMA_PERSIST_DIR (Render, plain
# local dev). docker-compose.yml sets CHROMA_HOST=chromadb for the backend
# container itself; an unreachable host falls back to the local store.
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=
CHROMA_PORT=8000

# ── Ask AI ───────────────────────────────────────────────────
# Gemini embedding model (text-embedding-004 was retired) and vector size.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
# Texts per embedding request; the free tier rejected 100 at once.
EMBEDDING_BATCH_SIZE=50
# Excerpts retrieved per question.
ASK_AI_TOP_K=8
# Best cosine similarity needed before Gemini is asked at all; below it the
# answer is "the collected data doesn't cover this". See docs/ASK_AI_PLAN.md.
ASK_AI_MIN_SIMILARITY=0.6
# Max chunks embedded per workflow (protects the free-tier embedding quota).
ASK_AI_MAX_CHUNKS=400
# Seconds a question waits for a workflow's index to be built before the API
# answers 202 "preparing" (the free tier embeds 100 texts a minute).
ASK_AI_INDEX_WAIT_SECONDS=25
# Embed each workflow as soon as its run completes. The free tier also caps
# embeddings at 1,000 texts a day (about 3-6 workflows); set false to embed
# only workflows someone asks about (on their first question).
ASK_AI_INDEX_ON_COMPLETE=true
# Questions per user per minute (in memory, per process).
ASK_AI_RATE_LIMIT_PER_MINUTE=10

# ── Observability ────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=changeme
