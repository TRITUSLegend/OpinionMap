# Application
APP_NAME=OpinionMap AI
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production --- IGNORE ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=AgentFlow/1.0

# NewsData.io API (free tier: 200 req/day -- sign up at newsdata.io)
NEWSDATA_API_KEY=your-newsdata-api-key

# The Guardian API (free: 5000 req/day -- sign up at open-platform.theguardian.com)
GUARDIAN_API_KEY=your-guardian-api-key

# Bluesky (AT Protocol) -- required for live search (post search is not public)
# Create an app password at Settings > App Passwords. Never use your main password.
# Leave blank to run the Bluesky source in demo/mock mode.
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password
# Hacker News: no credentials needed -- completely free public API

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
